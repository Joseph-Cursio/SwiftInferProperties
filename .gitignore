.claude/

# V1.50.A — cycle27-surface fixture's SwiftPM-resolved checkouts
fixtures/cycle27-surface/.build/
fixtures/cycle27-surface/Package.resolved

# The integer-division-generator fixture's build products. Unlike the fixtures
# above it resolves nothing over the network (the standard library is its
# subject), so there is no Package.resolved to ignore.
fixtures/integer-division-generator/.build/

# SwiftLint config backups left by the SwiftLintRuleStudio editor on save
.swiftlint.yml.*.backup

# Verify-pipeline synthesized SwiftPM workdirs (build artifacts; index.json
# stays tracked). Matches any `.swiftinfer/verify-workdir/` — the fixture's
# and any incidental one at the repo root from a dev `swift-infer verify` run.
**/.swiftinfer/verify-workdir/

# Python bytecode cache from the swift.org study scripts (scripts/ is study
# tooling, not product code — the .py sources are tracked, the cache is not).
__pycache__/
*.pyc

# Calibration triage decision files — regenerable per-cycle scratch produced
# by `discover-interaction --interactive` / the cycle re-triage. The durable
# record is the cycle-N findings doc worksheet + calibration-cycle-N-data/.
**/.swiftinfer/interaction-decisions.json

# The verify-refutability experiment's generated artifacts. `index.json` is regenerable with
# `swift-infer index --target VerifyRefutability`, and the measured RESULTS are recorded in
# `predictions.json` alongside the frozen predictions — which is the file that matters.
fixtures/verify-refutability/.swiftinfer/
